# legible-scanner — read-only. NO private keys belong in this file, ever.
# Dedicated RPC key strongly recommended: a free public tool is unbounded traffic, and the shared
# Helius key was already traced as a bottleneck on 2026-08-29.
SCANNER_RPC_ENDPOINT=
SCANNER_PORT=8810
SCANNER_SAMPLE_MS=45000        # per-venue sample interval (staggered across venues)
SCANNER_HEAT_SIGS=300          # signatures per sample
SCANNER_BASELINE_DAYS=7        # rolling window for the p95 baseline
SCANNER_MIN_SAMPLES=40         # samples before heat stops reporting `calibrating`
SCANNER_RATE_MAX=120           # requests/min/IP (handlers are cache-only)
